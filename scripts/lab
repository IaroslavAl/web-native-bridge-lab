#!/usr/bin/env node

import { execFile, spawn } from 'node:child_process';
import { randomBytes } from 'node:crypto';
import { closeSync, openSync } from 'node:fs';
import {
  access,
  mkdir,
  readFile,
  realpath,
  rename,
  rm,
  stat,
  writeFile,
} from 'node:fs/promises';
import net from 'node:net';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { promisify } from 'node:util';

const execFileAsync = promisify(execFile);
const SCRIPT_PATH = fileURLToPath(import.meta.url);
const REPO_ROOT = path.resolve(path.dirname(SCRIPT_PATH), '..');
const SERVER_PATH = path.join(REPO_ROOT, 'backend', 'server.mjs');
const HOST = '127.0.0.1';
const LOCK_WAIT_MS = 5_000;
const READY_WAIT_MS = 10_000;
const STOP_WAIT_MS = 5_000;

class OperationalError extends Error {
  constructor(message) {
    super(message);
    this.exitCode = 1;
  }
}

function parseArguments(argv) {
  const command = argv[0];
  if (!['start', 'status', 'stop'].includes(command)) {
    throw new Error('usage: scripts/lab <start|status|stop> [options]');
  }
  const options = {
    stateDir: path.join(REPO_ROOT, '.artifacts', 'lab'),
    webPort: 8787,
    apiPort: 8788,
    webRoot: path.join(REPO_ROOT, 'web', 'dist'),
  };
  for (let index = 1; index < argv.length; index += 2) {
    const name = argv[index];
    const value = argv[index + 1];
    if (value === undefined) throw new Error(`missing value for ${name}`);
    if (name === '--state-dir') options.stateDir = value;
    else if (name === '--web-port') options.webPort = Number(value);
    else if (name === '--api-port') options.apiPort = Number(value);
    else if (name === '--web-root') options.webRoot = value;
    else throw new Error(`unknown option: ${name}`);
  }
  if (!path.isAbsolute(options.stateDir) || !path.isAbsolute(options.webRoot)) {
    throw new Error('--state-dir and --web-root must be absolute paths');
  }
  if (![options.webPort, options.apiPort].every((port) => Number.isInteger(port) && port >= 1 && port <= 65_535)) {
    throw new Error('ports must be integers from 1 to 65535');
  }
  if (options.webPort === options.apiPort) throw new Error('web and API ports must be distinct');
  return {
    command,
    stateDir: path.resolve(options.stateDir),
    webPort: options.webPort,
    apiPort: options.apiPort,
    webRoot: path.resolve(options.webRoot),
  };
}

function sleep(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function processExists(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === 'EPERM';
  }
}

async function processDetails(pid) {
  if (!Number.isInteger(pid) || pid <= 0 || !processExists(pid)) return null;
  try {
    const [{ stdout: start }, { stdout: command }] = await Promise.all([
      execFileAsync('/bin/ps', ['-o', 'lstart=', '-p', String(pid)]),
      execFileAsync('/bin/ps', ['-o', 'command=', '-p', String(pid)]),
    ]);
    const startIdentity = start.trim();
    const commandLine = command.trim();
    return startIdentity && commandLine ? { startIdentity, commandLine } : null;
  } catch {
    return null;
  }
}

async function sameProcess(pid, startIdentity) {
  const details = await processDetails(pid);
  return Boolean(details && details.startIdentity === startIdentity);
}

async function acquireLock(stateDir) {
  await mkdir(stateDir, { recursive: true });
  const lockPath = path.join(stateDir, '.lock');
  const ownerPath = path.join(lockPath, 'owner.json');
  const deadline = Date.now() + LOCK_WAIT_MS;

  while (Date.now() < deadline) {
    try {
      await mkdir(lockPath);
      const ownDetails = await processDetails(process.pid);
      await writeFile(ownerPath, `${JSON.stringify({
        pid: process.pid,
        startIdentity: ownDetails?.startIdentity ?? null,
      })}\n`, { flag: 'wx' });
      return async () => rm(lockPath, { recursive: true, force: true });
    } catch (error) {
      if (error.code !== 'EEXIST') throw error;
      let stale = false;
      try {
        const owner = JSON.parse(await readFile(ownerPath, 'utf8'));
        stale = !(await sameProcess(owner.pid, owner.startIdentity));
      } catch {
        try {
          const lockStats = await stat(lockPath);
          stale = Date.now() - lockStats.mtimeMs > 1_000;
        } catch {
          stale = false;
        }
      }
      if (stale) {
        await rm(lockPath, { recursive: true, force: true });
        continue;
      }
      await sleep(50);
    }
  }
  throw new OperationalError(`timed out waiting for lifecycle lock: ${stateDir}`);
}

async function withLock(options, operation) {
  const release = await acquireLock(options.stateDir);
  try {
    return await operation();
  } finally {
    await release();
  }
}

async function readState(options) {
  try {
    return JSON.parse(await readFile(path.join(options.stateDir, 'state.json'), 'utf8'));
  } catch (error) {
    if (error.code === 'ENOENT') return null;
    if (error instanceof SyntaxError) return { malformed: true };
    throw error;
  }
}

async function writeState(options, state) {
  const statePath = path.join(options.stateDir, 'state.json');
  const temporaryPath = path.join(options.stateDir, `.state-${process.pid}-${randomBytes(4).toString('hex')}.tmp`);
  await writeFile(temporaryPath, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
  await rename(temporaryPath, statePath);
}

async function removeState(options) {
  await rm(path.join(options.stateDir, 'state.json'), { force: true });
}

function stateMatchesOptions(state, options) {
  return state.webPort === options.webPort
    && state.apiPort === options.apiPort
    && state.webRoot === options.webRoot
    && state.stateDir === options.stateDir
    && state.repoRoot === REPO_ROOT
    && state.scriptPath === SERVER_PATH;
}

async function verifiedOwnedProcess(state) {
  if (!state
      || state.version !== 1
      || !Number.isInteger(state.pid)
      || typeof state.token !== 'string'
      || !/^[a-f0-9]{32}$/.test(state.token)
      || typeof state.startIdentity !== 'string'
      || state.repoRoot !== REPO_ROOT
      || state.scriptPath !== SERVER_PATH) {
    return null;
  }
  const details = await processDetails(state.pid);
  if (!details || details.startIdentity !== state.startIdentity) return null;
  const expectedCommand = [
    process.execPath, SERVER_PATH,
    '--state-dir', state.stateDir,
    '--web-root', state.webRoot,
    '--web-port', String(state.webPort),
    '--api-port', String(state.apiPort),
    '--token', state.token,
    '--repo-root', REPO_ROOT,
  ].join(' ');
  if (details.commandLine !== expectedCommand) return null;
  return {
    pid: state.pid,
    startIdentity: state.startIdentity,
    scriptPath: state.scriptPath,
    repoRoot: state.repoRoot,
  };
}

async function assetsAvailable(webRoot) {
  try {
    const [root, index] = await Promise.all([
      realpath(webRoot),
      realpath(path.join(webRoot, 'index.html')),
    ]);
    const indexStats = await stat(index);
    return indexStats.isFile() && (index === root || index.startsWith(`${root}${path.sep}`));
  } catch {
    return false;
  }
}

async function portIsFree(port) {
  const server = net.createServer();
  return new Promise((resolve) => {
    server.unref();
    server.once('error', () => resolve(false));
    server.listen(port, HOST, () => {
      server.close(() => resolve(true));
    });
  });
}

async function health(port, service) {
  try {
    const response = await fetch(`http://${HOST}:${port}/healthz`, {
      cache: 'no-store',
      signal: AbortSignal.timeout(500),
    });
    return response.status === 200
      && response.headers.get('cache-control') === 'no-store'
      && JSON.stringify(await response.json()) === JSON.stringify({ service, protocol: 1 });
  } catch {
    return false;
  }
}

async function bothHealthy(options) {
  const [web, api] = await Promise.all([
    health(options.webPort, 'web'),
    health(options.apiPort, 'api'),
  ]);
  return web && api;
}

async function waitUntil(check, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  do {
    if (await check()) return true;
    await sleep(50);
  } while (Date.now() < deadline);
  return false;
}

function statusPayload(options, state, processes) {
  return {
    state,
    webPort: options.webPort,
    apiPort: options.apiPort,
    assetsAvailable: false,
    processes,
  };
}

async function inspectStatus(options) {
  const state = await readState(options);
  const assets = await assetsAvailable(options.webRoot);
  if (state) {
    const owned = await verifiedOwnedProcess(state);
    if (owned) {
      const status = stateMatchesOptions(state, options) && await bothHealthy(options)
        ? 'running'
        : 'conflict';
      return { ...statusPayload(options, status, [owned]), assetsAvailable: assets };
    }
    const [webFree, apiFree] = await Promise.all([
      portIsFree(options.webPort),
      portIsFree(options.apiPort),
    ]);
    const status = webFree && apiFree ? 'stale' : 'conflict';
    return { ...statusPayload(options, status, []), assetsAvailable: assets };
  }
  const [webFree, apiFree] = await Promise.all([
    portIsFree(options.webPort),
    portIsFree(options.apiPort),
  ]);
  const status = webFree && apiFree ? 'stopped' : 'conflict';
  return { ...statusPayload(options, status, []), assetsAvailable: assets };
}

async function stopVerifiedProcess(state) {
  let owned = await verifiedOwnedProcess(state);
  if (!owned) return;
  process.kill(state.pid, 'SIGTERM');
  const stopped = await waitUntil(async () => !(await verifiedOwnedProcess(state)), STOP_WAIT_MS);
  if (stopped) return;
  owned = await verifiedOwnedProcess(state);
  if (owned) process.kill(state.pid, 'SIGKILL');
  const killed = await waitUntil(async () => !(await verifiedOwnedProcess(state)), 1_000);
  if (!killed) throw new OperationalError(`owned process ${state.pid} did not stop`);
}

async function start(options) {
  return withLock(options, async () => {
    const existing = await readState(options);
    if (existing) {
      const owned = await verifiedOwnedProcess(existing);
      if (owned) {
        if (stateMatchesOptions(existing, options) && await bothHealthy(options)) {
          console.log(`already running pid=${existing.pid}`);
          return;
        }
        throw new OperationalError('owned lab state is unhealthy or requested configuration differs; stop with the original options first');
      }
      const [webFree, apiFree] = await Promise.all([
        portIsFree(options.webPort),
        portIsFree(options.apiPort),
      ]);
      if (!webFree || !apiFree) {
        throw new OperationalError('stale ownership state conflicts with an occupied requested port; refusing to signal it');
      }
      await removeState(options);
    }

    if (!(await portIsFree(options.webPort))) {
      throw new OperationalError(`web port ${options.webPort} is occupied; foreign process left untouched`);
    }
    if (!(await portIsFree(options.apiPort))) {
      throw new OperationalError(`API port ${options.apiPort} is occupied; foreign process left untouched`);
    }

    const token = randomBytes(16).toString('hex');
    const logPath = path.join(options.stateDir, 'server.log');
    const logDescriptor = openSync(logPath, 'a', 0o600);
    const argumentsList = [
      SERVER_PATH,
      '--state-dir', options.stateDir,
      '--web-root', options.webRoot,
      '--web-port', String(options.webPort),
      '--api-port', String(options.apiPort),
      '--token', token,
      '--repo-root', REPO_ROOT,
    ];
    const child = spawn(process.execPath, argumentsList, {
      cwd: REPO_ROOT,
      detached: true,
      stdio: ['ignore', logDescriptor, logDescriptor],
    });
    closeSync(logDescriptor);
    child.unref();

    let state;
    try {
      const detailsReady = await waitUntil(async () => {
        const details = await processDetails(child.pid);
        return Boolean(details && details.commandLine.includes(SERVER_PATH) && details.commandLine.includes(token));
      }, 2_000);
      if (!detailsReady) throw new Error('server process identity was not observable');
      const details = await processDetails(child.pid);
      state = {
        version: 1,
        pid: child.pid,
        startIdentity: details.startIdentity,
        token,
        repoRoot: REPO_ROOT,
        scriptPath: SERVER_PATH,
        stateDir: options.stateDir,
        webRoot: options.webRoot,
        webPort: options.webPort,
        apiPort: options.apiPort,
        logPath,
      };
      await writeState(options, state);
      const ready = await waitUntil(async () => {
        const owned = await verifiedOwnedProcess(state);
        return Boolean(owned && await bothHealthy(options));
      }, READY_WAIT_MS);
      if (!ready) throw new Error('readiness deadline exceeded');
      console.log(`started pid=${state.pid} web=${options.webPort} api=${options.apiPort}`);
    } catch (error) {
      if (state && await verifiedOwnedProcess(state)) await stopVerifiedProcess(state);
      else if (child.exitCode === null && child.pid) child.kill('SIGTERM');
      await removeState(options);
      await waitUntil(async () => (
        await portIsFree(options.webPort) && await portIsFree(options.apiPort)
      ), 1_000);
      throw new OperationalError(`failed to start lab: ${error.message}`);
    }
  });
}

async function status(options) {
  const payload = await withLock(options, () => inspectStatus(options));
  payload.assetsAvailable = await assetsAvailable(options.webRoot);
  console.log(JSON.stringify(payload));
  if (payload.state !== 'running') process.exitCode = 1;
}

async function stop(options) {
  return withLock(options, async () => {
    const state = await readState(options);
    if (!state) {
      const [webFree, apiFree] = await Promise.all([
        portIsFree(options.webPort),
        portIsFree(options.apiPort),
      ]);
      if (!webFree || !apiFree) {
        throw new OperationalError('requested port is occupied without verified lab ownership; refusing to signal it');
      }
      console.log('already stopped');
      return;
    }

    const owned = await verifiedOwnedProcess(state);
    if (!owned) {
      const [webFree, apiFree] = await Promise.all([
        portIsFree(options.webPort),
        portIsFree(options.apiPort),
      ]);
      if (!webFree || !apiFree) {
        throw new OperationalError('state is stale and a requested port is occupied; refusing to signal it');
      }
      await removeState(options);
      console.log('removed stale state; no process signalled');
      return;
    }
    if (!stateMatchesOptions(state, options)) {
      throw new OperationalError('requested configuration does not match verified owned state; use the original options');
    }

    await stopVerifiedProcess(state);
    await removeState(options);
    const released = await waitUntil(async () => (
      await portIsFree(options.webPort) && await portIsFree(options.apiPort)
    ), 2_000);
    if (!released) {
      throw new OperationalError('owned process stopped, but one or more ports are now occupied; release not claimed');
    }
    console.log(`stopped pid=${state.pid}`);
  });
}

async function main() {
  const options = parseArguments(process.argv.slice(2));
  await access(SERVER_PATH);
  if (options.command === 'start') await start(options);
  else if (options.command === 'status') await status(options);
  else await stop(options);
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = error.exitCode ?? 2;
});