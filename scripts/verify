#!/usr/bin/env python3
"""Reproducible local gates. Stage1 is NOT the complete acceptance matrix."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
APP_ID = 'lab.webnative.BridgeLab'


def manifest(root):
    """Hash all regular files, including hidden resources; reject ambiguous symlinks."""
    files = {}
    for path in sorted(Path(root).rglob('*')):
        if path.is_symlink():
            raise AssertionError(f'manifest symlink unsupported: {path}')
        if path.is_file():
            files[path.relative_to(root).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
    assert files, f'manifest empty: {root}'
    return files


def require_same_app(before, after):
    for field in ('udid', 'container', 'files'):
        assert before[field] == after[field], f'installed app {field} changed'


def save(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


def require_stage2_events(text):
    expected = [
        'GET /fixtures/http-error 503 tag=s2-http',
        'POST /api/quote 422 tag=s2-quote',
        'GET /fixtures/business-error 200 tag=s2-business',
        'GET /fixtures/malformed-json 200 tag=s2-json',
        'GET /fixtures/delay connection-close tag=s2-timeout',
        'GET /fixtures/delay connection-close tag=s2-cancel',
        'GET /fixtures/delay 200 tag=s2-fast',
        'GET /fixtures/delay 200 tag=s2-slow',
    ]
    lines = text.splitlines()
    for event in expected:
        tag = event.split('tag=')[1]
        actual = [line for line in lines if line.endswith('tag=' + tag)]
        assert actual == [event], f'{tag} events: {actual}, expected exactly {event}'
    assert lines.index(expected[-2]) < lines.index(expected[-1]), 'concurrent completion order must be fast then slow'
    return expected


def require_stage3_events(text):
    # Only the interval after B and before stop/status health checks is supplied.
    # Inspect destinations even when a redirected request drops its original tag.
    expected = [
        'GET /fixtures/redirect-same 302 tag=s3-redirect-same',
        'GET /fixtures/redirect-cross 302 tag=s3-redirect-cross',
        'GET /fixtures/redirect-loop 307 tag=s3-redirect-loop',
        'POST /fixtures/echo 200 tag=s3-body-limit',
        'POST /fixtures/echo 200 tag=s3-hostile',
        'GET /fixtures/large 200 tag=s3-response-limit',
        'GET /fixtures/binary 200 tag=s3-binary',
        'GET /fixtures/invalid-utf8 200 tag=s3-encoding',
    ] + [f'GET /fixtures/delay 200 tag=s3-slot-{i}' for i in range(8)]
    lines = text.splitlines()
    for event in expected:
        tag = event.split('tag=')[1]
        actual = [line for line in lines if line.endswith('tag=' + tag)]
        assert actual == [event], f'{tag} events: {actual}, expected exactly {event}'
    for line in lines:
        assert not any(path in line for path in (' /api/catalog ', ' /healthz ', ' /stage3-')), f'forbidden destination hit: {line}'
        if ' /fixtures/redirect-' in line:
            assert line in expected and lines.count(line) == 1, f'redirect hop/repeat: {line}'
        if 'tag=s3-' in line:
            assert line in expected or line == 'GET /fixtures/large 200 tag=s3-response-over', f'unadmitted request hit: {line}'
    return expected


def require_stage4_events(events):
    for tag in ('reload', 'navigation', 'close', 'destruction'):
        actual = [e['event'] for e in events if e.get('path') == '/delay' and e.get('tag') == tag]
        assert actual == ['request', 'connection-close'], f'{tag} live socket events: {actual}'
    for event in events:
        path = event.get('path', '')
        assert not path.startswith(('/forbidden-', '/denied-')), f'forbidden destination: {path}'
        if event.get('event') == 'request' and event.get('tag', '').startswith('privacy-'):
            assert event.get('cookie') is False, f'ambient cookie: {event.get("tag")}'
            assert event.get('authorization') is False, f'ambient authorization: {event.get("tag")}'


def require_free_ports():
    sockets = []
    try:
        for port in (8787, 8788):
            sock = socket.socket()
            sockets.append(sock)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(('127.0.0.1', port))
                sock.listen()
            except OSError as error:
                raise RuntimeError(f'loopback port {port} unavailable; foreign listeners untouched') from error
    finally:
        for sock in sockets:
            sock.close()


class Run:
    def __init__(self, mode):
        self.out = ROOT / '.artifacts' / ('verify-' + mode + '-' + uuid.uuid4().hex[:10])
        self.out.mkdir(parents=True)
        self.env = {**os.environ, 'OPENSPEC_TELEMETRY': '0', 'OPENSPEC_NO_COMPLETIONS': '1',
                    'npm_config_cache': str(ROOT / '.artifacts/npm-cache'),
                    'PYTHONDONTWRITEBYTECODE': '1'}
        self.commands = []
        self.children = []
        print(f'Evidence: {self.out}', flush=True)
        save(self.out / 'source.json', {'head_sha': self.capture(['git', 'rev-parse', 'HEAD']),
                                      'branch': self.capture(['git', 'branch', '--show-current']),
                                      'working_diff': self.capture(['git', 'diff', '--stat'])})

    def capture(self, args):
        return subprocess.check_output(args, cwd=ROOT, env=self.env, text=True).strip()

    def spawn(self, args, log, env=None):
        # A group is owned only because THIS run created its session leader.
        # Never reconstruct ownership from a recorded PID or a process-name scan.
        child = subprocess.Popen(args, cwd=ROOT, env=env or self.env, stdout=log,
                                 stderr=subprocess.STDOUT, start_new_session=True)
        self.children.append(child)
        return child

    def stop_child(self, child):
        assert child in self.children, 'refusing unowned process group'
        def live_members():
            # Darwin killpg(group, 0) can return EPERM while the last member exits.
            # Inspect numeric group/state only; zombies cannot own listeners.
            rows = subprocess.check_output(['/bin/ps', '-axo', 'pid=,pgid=,stat='], text=True)
            return [row for row in rows.splitlines()
                    if row.split()[1] == str(child.pid) and not row.split()[2].startswith('Z')]

        def send(signum):
            try:
                os.killpg(child.pid, signum)
            except ProcessLookupError:
                pass
            except PermissionError:
                if live_members():
                    raise

        send(signal.SIGTERM)
        deadline = time.monotonic() + 2
        while live_members() and time.monotonic() < deadline:
            child.poll()
            time.sleep(0.05)
        if live_members():
            send(signal.SIGKILL)
        child.wait(timeout=10)
        deadline = time.monotonic() + 5
        while live_members() and time.monotonic() < deadline:
            time.sleep(0.05)
        assert not live_members(), 'owned command descendants survived cleanup'
        self.children.remove(child)

    def command(self, name, args, timeout=600, allowed=(0,)):
        args = [str(arg) for arg in args]
        print(f'RUN {name}', flush=True)
        record = {'name': name, 'argv': args, 'log': name + '.log'}
        self.commands.append(record)
        save(self.out / 'commands.json', self.commands)
        with (self.out / (name + '.log')).open('w') as log:
            child = self.spawn(args, log)
            try:
                code = child.wait(timeout=timeout)
            finally:
                self.stop_child(child)
            record['exit_code'] = code
        save(self.out / 'commands.json', self.commands)
        if code not in allowed:
            raise RuntimeError(f'{name} exit {code}; see {self.out / record["log"]}')
        return code

    def web(self, variant):
        self.command('web-build-' + variant, ['npm', '--prefix', 'web', 'run', 'build:' + variant.lower(),
                     '--', '--outDir', self.out / 'web', '--emptyOutDir'])
        files = manifest(self.out / 'web')
        save(self.out / ('web-' + variant + '.json'), files)
        return files

    def installed(self, udid, name):
        container = self.capture(['xcrun', 'simctl', 'get_app_container', udid, APP_ID, 'app'])
        value = {'udid': udid, 'container': container, 'files': manifest(Path(container))}
        assert 'BridgeLab' in value['files'], 'installed executable BridgeLab missing'
        assert not any('XCTest' in path or path.startswith('PlugIns/') for path in value['files']), 'A/B shell contains unit-test host artifacts'
        save(self.out / (name + '.json'), value)
        return value

    def unit(self):
        self.command('runner-tests', [sys.executable, '-m', 'unittest', 'discover', '-s', 'scripts/tests', '-v'])
        self.command('spec-install', ['npm', 'ci', '--prefix', 'openspec/tooling', '--ignore-scripts', '--no-audit', '--no-fund'])
        self.command('web-install', ['npm', 'ci', '--prefix', 'web', '--no-audit', '--no-fund'])
        self.command('web-audit', ['npm', 'audit', '--prefix', 'web', '--audit-level=high'])
        self.command('protocol', ['node', 'protocol/v1/validate.cjs'])
        self.command('openspec', ['openspec/tooling/node_modules/.bin/openspec', 'validate', '--all', '--strict', '--no-interactive', '--json'])
        self.command('backend', ['node', '--test', *sorted(str(p.relative_to(ROOT)) for p in (ROOT / 'backend/tests').glob('*.test.mjs'))])
        self.command('native', ['swift', 'test', '--package-path', 'native/TransportPackage', '-Xswiftc', '-warnings-as-errors'])
        self.command('ios-package', ['swift', 'test', '--package-path', 'ios', '-Xswiftc', '-warnings-as-errors'])
        self.command('web-tests', ['npm', '--prefix', 'web', 'test', '--', '--run'])
        self.command('web-types', ['npm', '--prefix', 'web', 'run', 'typecheck'])
        self.command('web-build-diagnostics', ['web/node_modules/.bin/vite', 'build', 'web',
                     '--config', 'web/vite.acceptance.config.ts', '--outDir', self.out / 'diagnostics-web', '--emptyOutDir'])
        a = self.web('A')
        b = self.web('B')
        assert a != b, 'web variants have identical file manifests'
        self.command('diff-check', ['git', 'diff', '--check'])
        save(self.out / 'result.json', {'unit': 'PASS', 'final_acceptance': False})

    def simulator(self, stage2=False, stage3=False, stage5=False):
        require_free_ports() # before creating resources; never steal existing lab services
        udid = None
        started = False
        tester = None
        test_log = None
        lab = ['node', str(ROOT / 'scripts/lab')]
        options = ['--state-dir', str(self.out / 'lab'), '--web-root', str(self.out / 'web')]
        try:
            runtimes = json.loads(self.capture(['xcrun', 'simctl', 'list', 'runtimes', '-j']))['runtimes']
            runtime = next(r for r in runtimes if r['isAvailable'] and r['name'].startswith('iOS'))
            device = next(d for d in runtime['supportedDeviceTypes'] if d['productFamily'] == 'iPhone')
            udid = self.capture(['xcrun', 'simctl', 'create', 'PER85-Stage1-' + uuid.uuid4().hex[:8], device['identifier'], runtime['identifier']])
            save(self.out / 'simulator.json', {'udid': udid, 'runtime': runtime['identifier'], 'device': device['identifier']})
            self.command('boot', ['xcrun', 'simctl', 'boot', udid])
            self.command('boot-ready', ['xcrun', 'simctl', 'bootstatus', udid, '-b'])
            base = ['xcodebuild', '-project', 'ios/BridgeLab.xcodeproj', '-destination', 'platform=iOS Simulator,id=' + udid,
                    '-derivedDataPath', str(self.out / 'derived'), 'CODE_SIGNING_ALLOWED=NO', '-parallel-testing-enabled', 'NO']
            # Unit tests inject bundles into their host app. Keep that build tree separate
            # so the A/B application is the uninstrumented production shell.
            unit_base = [str(self.out / 'unit-derived') if arg == str(self.out / 'derived') else arg for arg in base]
            self.command('ios-simulator-tests', unit_base + ['-scheme', 'BridgeLab', '-skip-testing:BridgeLabTests/LiveWebKitTests', '-resultBundlePath', self.out / 'unit.xcresult', 'test'], timeout=900)
            self.command('acceptance-build', base + ['-scheme', 'BridgeLabAcceptance', 'build-for-testing'], timeout=600)
            app = self.out / 'derived/Build/Products/Debug-iphonesimulator/BridgeLab.app'
            # Simulator replacement installs can retain the earlier unit-host PlugIns.
            # Remove that test host before installing the clean shell, strictly before A.
            self.command('remove-unit-host', ['xcrun', 'simctl', 'uninstall', udid, APP_ID])
            self.command('install', ['xcrun', 'simctl', 'install', udid, app])
            self.installed(udid, 'installed-before-ui-runner')
            a_web = self.web('A')
            control = self.out / 'web/stage1'
            control.mkdir()
            for name in ('ready', 'a-observed', 'b-observed'):
                (control / (name + '.txt')).write_text(name)
            started = True
            self.command('lab-start', lab + ['start'] + options)
            self.command('lab-status', lab + ['status'] + options)
            args = base + ['-scheme', 'BridgeLabAcceptance', '-resultBundlePath', str(self.out / 'ab.xcresult'), 'test-without-building']
            record = {'name': 'ab-ui', 'argv': args, 'log': 'ab-ui.log'}
            self.commands.append(record); save(self.out / 'commands.json', self.commands)
            test_log = (self.out / 'ab-ui.log').open('w')
            tester = self.spawn(args, test_log)
            server_log = self.out / 'lab/server.log'

            def wait_event(name):
                deadline = time.monotonic() + 180
                needle = 'GET /stage1/' + name + '.txt 200'
                while time.monotonic() < deadline:
                    if needle in server_log.read_text():
                        return
                    if tester.poll() is not None:
                        raise RuntimeError(f'UI runner exited {tester.returncode} before {name}; see ab-ui.log')
                    time.sleep(0.2)
                raise RuntimeError(f'UI milestone missing: {name}; see ab-ui.log')

            wait_event('ready')
            before = self.installed(udid, 'installed-before-A')
            (control / 'a-release.txt').write_text('release')
            wait_event('a-observed')
            after_a = self.installed(udid, 'installed-after-A')
            require_same_app(before, after_a)
            assert 'GET /api/catalog 200 tag=scenario-a' in server_log.read_text(), 'backend catalog attribution missing'
            # From here to B observation: ONLY web build, control files and read-only hashes.
            b_web = self.web('B')
            assert a_web != b_web, 'web A/B manifest did not change'
            control.mkdir()
            (control / 'b-observed.txt').write_text('marker')
            (control / 'b-release.txt').write_text('release')
            wait_event('b-observed')
            after_b = self.installed(udid, 'installed-after-B')
            require_same_app(before, after_b)
            assert 'POST /api/quote 200 tag=scenario-b' in server_log.read_text(), 'backend quote attribution missing'
            trust_offset = len(server_log.read_text())
            if stage2 or stage3:
                self.command('web-build-diagnostics', ['web/node_modules/.bin/vite', 'build', 'web',
                             '--config', 'web/vite.acceptance.config.ts', '--outDir', self.out / 'web', '--emptyOutDir'])
                (self.out / 'web/acceptance/index.html').replace(self.out / 'web/index.html')
                save(self.out / 'web-diagnostics.json', manifest(self.out / 'web'))
                control.mkdir()
                for name in ('diagnostics-enabled', 'matrix-observed'):
                    (control / (name + '.txt')).write_text(name)
                if stage3:
                    (control / 'trust-enabled.txt').write_text('test-only trust probes')
            if stage5:
                for name in ('production-ux-enabled', 'matrix-observed'):
                    (control / (name + '.txt')).write_text(name)
            (control / 'finish.txt').write_text('release')
            if stage5:
                wait_event('matrix-observed')
                require_same_app(before, self.installed(udid, 'installed-after-production-ux'))
                ux_log = server_log.read_text()[trust_offset:]
                (self.out / 'stage5-backend.log').write_text(ux_log)
                for event in ('GET /fixtures/http-error 503 tag=diagnostic',
                              'GET /fixtures/business-error 200 tag=diagnostic',
                              'GET /fixtures/malformed-json 200 tag=diagnostic',
                              'GET /fixtures/delay connection-close tag=diagnostic',
                              'GET /fixtures/delay connection-close tag=concurrent-slow',
                              'GET /fixtures/delay 200 tag=concurrent-fast'):
                    assert ux_log.splitlines().count(event) == 1, f'production UI backend event: {event}'
                assert 'GET /fixtures/delay 200 tag=concurrent-slow' not in ux_log, 'cancelled slow succeeded'
            if stage2 or stage3:
                wait_event('matrix-observed')
                if stage3:
                    trust_log = server_log.read_text()[trust_offset:]
                    (self.out / 'stage3-backend.log').write_text(trust_log)
                    events = require_stage3_events(trust_log)
                    save(self.out / 'stage3-events.json', events)
                else:
                    events = require_stage2_events(server_log.read_text())
                    save(self.out / 'stage2-events.json', events)
                require_same_app(before, self.installed(udid, 'installed-after-diagnostics'))
                # Only now stop our actual backend. The already-loaded test React page
                # submits one more native request while both ports are demonstrably off.
                self.command('network-off', lab + ['stop'] + options)
                require_free_ports()
                self.command('network-off-status', lab + ['status'] + options, allowed=(1,))
            code = tester.wait(timeout=120)
            record['exit_code'] = code; save(self.out / 'commands.json', self.commands)
            assert code == 0, f'UI test exit_code={code}; see ab-ui.log'
            for name in ('unit', 'ab'):
                summary = json.loads(self.capture(['xcrun', 'xcresulttool', 'get', 'test-results', 'summary', '--path', str(self.out / (name + '.xcresult')), '--format', 'json']))
                save(self.out / (name + '-summary.json'), summary)
                assert summary['failedTests'] == 0, f'{name} failedTests={summary["failedTests"]}'
                assert summary['passedTests'] > 0, f'{name} passedTests=0'
                assert summary['skippedTests'] == 0, f'{name} skippedTests={summary["skippedTests"]}'
            result = {'stage1': 'PASS', 'final_acceptance': False, 'udid': udid,
                 'executable_sha256': before['files']['BridgeLab'], 'manifest_sha256': hashlib.sha256(json.dumps(before['files'], sort_keys=True).encode()).hexdigest(),
                 'installed_files': len(before['files']), 'same_container': True, 'same_manifest': True,
                 'web_A': a_web, 'web_B': b_web}
            if stage5:
                result['stage5_production_ux'] = 'PASS'
            if stage2:
                result['stage2_outcomes'] = 'PASS'
                result['stage2_events'] = events
                result['full_security_lifecycle_matrix'] = 'PENDING'
            if stage3:
                result['stage3_trust_limits'] = 'PASS'
                result['stage3_events'] = events
                result['full_security_lifecycle_matrix'] = 'PENDING'
        finally:
            cleanup_errors = []
            if tester is not None:
                self.stop_child(tester)
            if test_log is not None:
                test_log.close()
            if started:
                try:
                    self.command('lab-stop', lab + ['stop'] + options)
                    require_free_ports()
                    self.command('lab-stopped-status', lab + ['status'] + options, allowed=(1,))
                except Exception as error:
                    cleanup_errors.append(str(error))
            if udid:
                try:
                    states = json.loads(self.capture(['xcrun', 'simctl', 'list', 'devices', '-j']))['devices']
                    current = next(d for group in states.values() for d in group if d['udid'] == udid)
                    if current['state'] != 'Shutdown':
                        self.command('simulator-shutdown', ['xcrun', 'simctl', 'shutdown', udid])
                    self.command('simulator-delete', ['xcrun', 'simctl', 'delete', udid])
                    states = json.loads(self.capture(['xcrun', 'simctl', 'list', 'devices', '-j']))['devices']
                    assert all(d['udid'] != udid for group in states.values() for d in group), 'owned Simulator remains'
                except Exception as error:
                    cleanup_errors.append(str(error))
            save(self.out / 'cleanup.json', {'errors': cleanup_errors, 'owned_simulator_removed': bool(udid) and not cleanup_errors,
                                            'owned_services_stopped': started and not cleanup_errors})
            if cleanup_errors:
                raise RuntimeError('cleanup failed: ' + '; '.join(cleanup_errors))
        # Never emit a successful result if cleanup failed.
        save(self.out / 'result.json', result)


    def webkit(self):
        # Same runner/resource ownership, component host rather than installed React.
        import urllib.request
        require_free_ports()
        udid = None
        fixture = None
        cleanup_errors = []
        try:
            with (self.out / 'fixture.log').open('w') as log:
                fixture = self.spawn(['node', str(ROOT / 'scripts/tests/webkit-fixture.mjs'),
                                      str(self.out / 'events.json')], log)
            deadline = time.monotonic() + 10
            while True:
                assert fixture.poll() is None, 'owned fixture exited before readiness'
                try:
                    with urllib.request.urlopen('http://127.0.0.1:8787/__state', timeout=1) as response:
                        assert json.load(response)['fixture'] == 'PER85-Stage4', 'fixture identity'
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise RuntimeError('fixture readiness deadline')
                    time.sleep(0.05)
            runtimes = json.loads(self.capture(['xcrun', 'simctl', 'list', 'runtimes', '-j']))['runtimes']
            runtime = next(r for r in runtimes if r['isAvailable'] and r['name'].startswith('iOS'))
            device = next(d for d in runtime['supportedDeviceTypes'] if d['productFamily'] == 'iPhone')
            udid = self.capture(['xcrun', 'simctl', 'create', 'PER85-Stage4-' + uuid.uuid4().hex[:8], device['identifier'], runtime['identifier']])
            save(self.out / 'simulator.json', {'udid': udid, 'runtime': runtime['identifier'], 'device': device['identifier'], 'fixture_pid': fixture.pid})
            self.command('boot', ['xcrun', 'simctl', 'boot', udid])
            self.command('boot-ready', ['xcrun', 'simctl', 'bootstatus', udid, '-b'])
            self.command('webkit-tests', ['xcodebuild', '-project', 'ios/BridgeLab.xcodeproj', '-scheme', 'BridgeLab',
                         '-destination', 'platform=iOS Simulator,id=' + udid, '-derivedDataPath', self.out / 'derived',
                         '-resultBundlePath', self.out / 'webkit.xcresult', 'CODE_SIGNING_ALLOWED=NO',
                         '-parallel-testing-enabled', 'NO', 'test'], timeout=900)
            summary = json.loads(self.capture(['xcrun', 'xcresulttool', 'get', 'test-results', 'summary', '--path', str(self.out / 'webkit.xcresult'), '--format', 'json']))
            save(self.out / 'webkit-summary.json', summary)
            assert summary['failedTests'] == 0, f'webkit failedTests={summary["failedTests"]}'
            assert summary['skippedTests'] == 0, f'webkit skippedTests={summary["skippedTests"]}'
            assert summary['passedTests'] == 53, f'webkit passedTests={summary["passedTests"]}, expected 42 regression + 11 live tests'
            require_stage4_events(json.loads((self.out / 'events.json').read_text()))
        finally:
            if fixture:
                self.stop_child(fixture)
                try:
                    require_free_ports()
                except Exception as error:
                    cleanup_errors.append(str(error))
            if udid:
                try:
                    states = json.loads(self.capture(['xcrun', 'simctl', 'list', 'devices', '-j']))['devices']
                    current = next(d for group in states.values() for d in group if d['udid'] == udid)
                    if current['state'] != 'Shutdown':
                        self.command('simulator-shutdown', ['xcrun', 'simctl', 'shutdown', udid])
                    self.command('simulator-delete', ['xcrun', 'simctl', 'delete', udid])
                    states = json.loads(self.capture(['xcrun', 'simctl', 'list', 'devices', '-j']))['devices']
                    assert all(d['udid'] != udid for group in states.values() for d in group), 'owned Simulator remains'
                except Exception as error:
                    cleanup_errors.append(str(error))
            save(self.out / 'cleanup.json', {'errors': cleanup_errors, 'owned_fixture_stopped': fixture is not None and fixture.poll() is not None,
                                            'owned_simulator_removed': bool(udid) and not cleanup_errors})
            if cleanup_errors:
                raise RuntimeError('cleanup failed: ' + '; '.join(cleanup_errors))
        save(self.out / 'result.json', {'stage4_webkit_privacy': 'PASS', 'layer': 'real WebKit component + real native network', 'final_acceptance': False})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['unit', 'simulator-stage1', 'simulator-stage2-outcomes', 'simulator-stage3-trust-limits', 'simulator-stage4-webkit-privacy', 'simulator-stage5-production-ux'])
    args = parser.parse_args()
    def interrupted(signum, frame):
        raise KeyboardInterrupt(f'signal {signum}')
    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, interrupted)
    run = Run(args.mode)
    try:
        if args.mode == 'unit':
            run.unit()
        elif args.mode == 'simulator-stage4-webkit-privacy':
            run.webkit()
        else:
            run.simulator(stage2=args.mode == 'simulator-stage2-outcomes', stage3=args.mode == 'simulator-stage3-trust-limits', stage5=args.mode == 'simulator-stage5-production-ux')
        print(f'PASS {args.mode}; not final product acceptance. Evidence: {run.out}', flush=True)
    except BaseException as error:
        save(run.out / 'failure.json', {'error': str(error), 'type': type(error).__name__})
        print(f'FAIL {args.mode}: {error}; evidence: {run.out}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
